# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files - but keep example
.env
.env.local
.env.*.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
dev.log
test
!src/app/api/admin/email-settings/test/
prompt

server.log

# Database files (keep structure)
# NB: db/custom.db est EXCEPTIONNÉ car c'est la vraie base runtime (DATABASE_URL .env).
# Sans exception, la plateforme restore le workspace entre sessions → données perdues.
db/*.db
db/*.db-journal
db/*.db-wal
db/*.db-shm
db/*.db-oplog
!db/.gitkeep
!db/custom.db
# Token push GitHub (JAMAIS committé)
.zscripts/.gittoken
.zscripts/*.log
tool-results/

# Uploads (user data)
/upload/*
!upload/.gitkeep

# Skills directory
/skills/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
Thumbs.db